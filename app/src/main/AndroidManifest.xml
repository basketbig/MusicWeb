<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission is required to load the Spotify web player -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        FOREGROUND_SERVICE: richiesto da ogni startForeground() su API 28+.
        NON deve avere maxSdkVersion: senza questo permesso il sistema
        uccide il servizio con SecurityException all'avvio (Android 14 incluso).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Tipo FGS obbligatorio da Android 14 (API 34): serve SOLO dalla API 29 in su -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        android:minSdkVersion="29" />
    <!-- Necessario per mostrare la notifica su Android 13+ (runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpotifyWrapper"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.SpotifyWrapper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
