<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission is required to load the Spotify web player -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        FOREGROUND_SERVICE: richiesto da ogni startForeground() su API 28+ (P).
        Il permesso viene concesso automaticamente all'installazione (normal
        permission), ma DEVE essere dichiarato o il sistema lancia
        SecurityException: "startForeground ... requires
        android.permission.FOREGROUND_SERVICE" (il crash visto su Android 14).
        Attenzione: qui maxSdkVersion/minSdkVersion NON vanno mai messi.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Tipo FGS mediaPlayback: obbligatorio da Android 14 (API 34), introdotto API 29 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Necessario per mostrare la notifica su Android 13+ (runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Il renderer audio della WebView ha bisogno della CPU sveglia durante il
         playback a schermo spento: senza, Doze sospende i timer JS e la pagina
         perde il keep-alive della sessione (risulta offline dal PC). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpotifyWrapper"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SpotifyWrapper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
